{
  "expo": {
    "name": "Sabong",
    "slug": "sabong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sabong_favicon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "sabong",
    "splash": {
      "image": "./assets/sabong_favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.sabong"
    },
    "android": {
      "package": "com.yourname.sabong",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sabong_favicon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/sabong_favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/sabong_favicon.png",
          "color": "#D4AF37"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0ccc0339-fdd1-4ec1-b81b-988a1b2348fe"
      }
    }
  }
}
